<ui:FluentWindow x:Class="QuietMic.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="QuietMic"
                 Width="900"
                 Height="720"
                 MinWidth="760"
                 MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ThemeMode="System"
                 Background="Transparent"
                 Closing="OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="QuietMic">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Mic24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="28,4,28,0">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="QuietMic" />
            <TextBlock Margin="0,4,0,0" Opacity="0.62" Text="神经网络实时降噪 · 把干净的语音送进虚拟麦克风" />
            <ui:InfoBar x:Name="ErrorBar"
                        Margin="0,14,0,0"
                        Severity="Error"
                        IsOpen="False"
                        IsClosable="True" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Margin="28,12,28,24" MaxWidth="820">

                <ui:Card>
                    <StackPanel Margin="20">
                        <DockPanel>
                            <ui:Button x:Name="RefreshButton"
                                       DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="刷新设备列表"
                                       Click="OnRefreshClick" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Mic24" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="输入麦克风" />
                            </StackPanel>
                        </DockPanel>

                        <ComboBox x:Name="MicCombo"
                                  Margin="0,14,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnMicrophoneChanged" />

                        <TextBlock Margin="0,14,0,6" Opacity="0.62" Text="输入电平" />
                        <ProgressBar x:Name="InputLevelBar" Maximum="100" Height="6" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,12,0,0">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Sparkle24" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="降噪引擎" />
                        </StackPanel>

                        <ComboBox x:Name="ModelCombo"
                                  Margin="0,14,0,0"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnModelChanged" />

                        <TextBlock x:Name="ModelDescription"
                                   Margin="0,8,0,0"
                                   Opacity="0.62"
                                   TextWrapping="Wrap" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button x:Name="DownloadButton"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Content="下载模型"
                                       Click="OnDownloadClick" />
                            <ProgressBar x:Name="DownloadProgress"
                                         Width="180"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         Height="6"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="DownloadText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.62" />
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="降噪强度" />
                            <TextBlock x:Name="StrengthLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Opacity="0.62"
                                       Text="90%" />
                        </Grid>
                        <Slider x:Name="StrengthSlider"
                                Margin="0,4,0,0"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                ValueChanged="OnStrengthChanged" />
                        <TextBlock Margin="0,2,0,0"
                                   Opacity="0.5"
                                   FontSize="12"
                                   Text="100% 为完全降噪，较低的值会保留更多环境声。" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="旁路" />
                                <TextBlock Opacity="0.5" FontSize="12" Text="跳过降噪，用于 A/B 对比" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="BypassToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="OnBypassChanged"
                                             Unchecked="OnBypassChanged" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="耳返监听" />
                                <TextBlock Opacity="0.5" FontSize="12" Text="在耳机里听到降噪后的声音" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="MonitorToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="OnMonitorToggled"
                                             Unchecked="OnMonitorToggled" />
                        </Grid>

                        <ComboBox x:Name="MonitorCombo"
                                  Margin="0,10,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnMonitorDeviceChanged" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,12,0,0">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="CableIcon" Symbol="Warning24" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="虚拟麦克风" />
                        </StackPanel>

                        <TextBlock x:Name="CableStatus"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <ui:Button x:Name="InstallCableButton"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Content="安装虚拟声卡"
                                       Appearance="Primary"
                                       Click="OnInstallCableClick" />
                            <ui:Button Margin="10,0,0,0"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Content="打开声音设置"
                                       Click="OnOpenSoundSettingsClick" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="28,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="14" Text="就绪" />
                    <ProgressBar x:Name="OutputLevelBar" Margin="0,8,24,0" Maximum="100" Height="4" />
                </StackPanel>

                <ui:Button x:Name="StartButton"
                           Grid.Column="1"
                           Width="168"
                           Height="44"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Play24}"
                           Content="启动"
                           Click="OnStartClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
